{
  "name": "idle-game-academy",
  "version": "1.0.0",
  "private": true,
  "description": "A self-paced course that takes you from TypeScript fundamentals to shipping a full-stack, mobile-first idle game with React, Node, Postgres and cloud saves.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "watch": "node scripts/check.mjs --watch",
    "progress": "node scripts/progress.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:solutions": "cross-env SOLUTIONS=1 vitest run"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "immer": "^11.2.10",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
